...@../../_tools/theme
direction: right

plan: "run_mcp_travel_planner" { class: ours }
sync: "run_travel_planner\n(asyncio.run)" { class: ours }
mcp: "MCP 도구 묶음\n(MultiMCPTools)" { class: ours }
gs: "구글 검색 도구\n(GoogleSearchTools)" { class: ours }
agent: "여행 에이전트\n(Agent)" { class: ours }

sync -> plan: "asyncio.run"
plan -> sync: "일정 글 (return)"
plan -> mcp: "MultiMCPTools(명령 둘, env)\nconnect() · close()"
plan -> gs: "GoogleSearchTools()"
plan -> agent: "Agent(tools=[mcp, gs])\narun(프롬프트)"
agent -> plan: "response.content"
