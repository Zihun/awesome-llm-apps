...@../../_tools/theme
shape: sequence_diagram

agent: "여행 에이전트\n(Agent)" { class: ours }
srva: "Airbnb MCP 서버" { class: ext }
geo: "Photon ·\nNominatim" { class: ext }
abnb: "airbnb.com" { class: ext }

agent -> srva: "ping"
srva -> agent: "ping 응답"
agent -> srva: "tools/call airbnb_search\n(location · maxPrice)"
srva -> geo: "location 문자열을 보냄\n(placeId가 없을 때, Photon이\n실패하면 Nominatim)"
geo -> srva: "지도 범위"
srva -> abnb: "HTTPS"
abnb -> srva: "HTML"
srva -> agent: "listings JSON"
