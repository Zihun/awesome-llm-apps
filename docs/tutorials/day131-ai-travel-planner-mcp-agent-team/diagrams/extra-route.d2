...@../../_tools/theme
shape: sequence_diagram

agent: "여행 에이전트\n(Agent)" { class: ours }
srvm: "여행 플래너\nMCP 서버" { class: ext }
gmaps: "Google Maps\nAPI" { class: ext }

agent -> srvm: "ping"
srvm -> agent: "ping 응답"
agent -> srvm: "tools/call calculateRoute\n(origin · destination · mode)"
srvm -> gmaps: "Directions 요청"
gmaps -> srvm: "경로 JSON"
srvm -> agent: "거리 · 시간 JSON"
