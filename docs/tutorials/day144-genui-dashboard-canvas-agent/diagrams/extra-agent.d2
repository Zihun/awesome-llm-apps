...@../../_tools/theme
direction: down

adk: "AG-UI 어댑터\n(ADKAgent)" { class: ours }
dagent: "DashboardAgent\n(agent.py)" { class: ours }
tools: "지표 도구\n(tools.py)" { class: ours }
search: "SearchAgent\n(google_search)" { class: ours }
state: "세션 상태\n(메모리)" { class: store }
gemini: "Gemini\n(가짜 서버)" { class: ext }

adk -> dagent: "Runner 실행"
dagent -> tools: "함수 도구 호출"
dagent -> search: "AgentTool 호출"
tools -> state: "pinnedMetrics 씀"
adk -> state: "input.state 덮어씀"
state -> adk: "최종 상태 읽음"
dagent -> gemini: "요청 1 · 3 · 4"
gemini -> dagent: "도구 호출 · 글"
search -> gemini: "요청 2 (googleSearch)"
gemini -> search: "검색 요약 글"
