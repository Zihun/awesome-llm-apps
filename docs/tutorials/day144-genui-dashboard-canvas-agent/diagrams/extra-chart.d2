...@../../_tools/theme
shape: sequence_diagram

gem: "Gemini (가짜 서버)" { class: ext }
dagent: "DashboardAgent" { class: ours }
adk: "ADKAgent" { class: ours }
rt: "런타임" { class: ours }
ui: "브라우저" { class: ours }

gem -> dagent: "add_pinned_metrics + add_chart 호출"
adk -> rt: "TOOL_CALL add_chart"
rt -> ui: "TOOL_CALL 중계"
adk -> rt: "RUN_FINISHED"
rt -> ui: "RUN_FINISHED 중계"
ui -> ui: "ChartCard 렌더 · [Add] 대기"
