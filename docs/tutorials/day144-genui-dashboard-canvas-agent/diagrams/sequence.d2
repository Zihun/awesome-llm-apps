...@../../_tools/theme
shape: sequence_diagram

user: 사용자 { class: person }
ui: "브라우저 (CopilotKit)" { class: ours }
rt: "런타임 (route.ts)" { class: ours }
adk: "AG-UI 어댑터 (ADKAgent)" { class: ours }
dagent: "DashboardAgent" { class: ours }
gem: "Gemini (가짜 서버)" { class: ext }

user -> ui: "질문 글"
ui -> rt: "POST /api/copilotkit"
rt -> adk: "POST / (state · messages · tools)"
adk -> adk: "input.state를 세션에 덮어씀"
adk -> rt: "RUN_STARTED"
rt -> ui: "RUN_STARTED 중계"
adk -> dagent: "Runner 실행"
dagent -> gem: "요청 1: 지침 + 도구 선언 셋"
gem -> dagent: "SearchAgent 호출"
adk -> rt: "TOOL_CALL SearchAgent"
rt -> ui: "TOOL_CALL 중계"
ui -> user: "검색 중 카드"
