...@../../_tools/theme
direction: down

app: "research_agent.py (처리 순서 1~6)" {
  class: ours
  grid-columns: 6

  sidebar: "1. 사이드바 입력" { class: ours }
  triage: "2. Triage Agent" { class: ours }
  research: "3. Research Agent" { class: ours }
  editor: "4. Editor Agent" { class: ours }
  facts: "5. collected_facts" { class: store }
  tabs: "6. 결과 탭" { class: ours }
}

input: "입력" {
  class: group
  user: 사용자 { class: person }
  env: OPENAI_API_KEY { class: file }
}

external: "외부 API" {
  class: group
  websearch: 호스티드 웹 검색 { class: ext }
  openai: OpenAI (gpt-4o-mini) { class: ext }
}

input -> app: 조사 주제·인증 입력, Start Research 클릭
app -> external.openai: 조사 계획 요청 (triage) · 보고서 작성 요청 (editor)
app -> external.websearch: 웹 검색 (research)
app -> input.user: 보고서 열람과 마크다운 내려받기
