...@../../_tools/theme
direction: down
grid-rows: 2

front: "요청 진입" {
  class: group
  grid-columns: 5
  env: 환경 변수 { class: file }
  user: 사용자 { class: person }
  web: ADK Web UI { class: ext }
  root: 코디네이터 (root_agent.yaml) { class: file }
  gemini: Gemini API (gemini-3-flash-preview) { class: ext }
}

agents: "하위 에이전트 · Firecrawl 연동" {
  class: group
  grid-columns: 4
  summary: 요약 에이전트 (summary_agent.yaml) { class: file }
  research: 리서치 에이전트 (research_agent.yaml) { class: file }
  mcp: MCP 서버 { class: ext }
  cloud: Firecrawl 클라우드 { class: ext }
}

front.user -> front.web: 메시지
front.web -> front.root: 로드 (from_config)
front.root -> agents: sub_agents: config_path
agents.research -> agents.mcp: MCPToolset (npx 프로세스)
agents.mcp -> agents.cloud: firecrawl_scrape / firecrawl_search
front.root -> front.gemini: 모델 호출
agents -> front.gemini: 모델 호출
