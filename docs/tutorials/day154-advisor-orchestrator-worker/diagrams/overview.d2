...@../../_tools/theme
direction: down

user: 독자 {
  class: person
  label.near: outside-top-center
}
evals: "시험 1~1b\n(구조 · 보안)" { class: ours }
trig: "시험 2~3\n(트리거 · 행동)" { class: ours }
skill: "스킬 폴더\n(SKILL.md)" { class: file }
install: "설치된 복사본\n(.claude/skills)" { class: file }
host: "오케스트레이터\n(에이전트)" { class: ours }
tmp: "임시 파일 (브리프 · 결과)" { class: file }
workers: "작업자 (agy)" { class: ext }
advisor: "조언자\n(claude CLI)" { class: ext }
gate: "검증 관문\n(PASS · FIX)" { class: ours }
api: "API 대체 길\n(Gemini · Anthropic)" { class: ext }

evals -> skill: "구조 · 보안 검사"
trig -> skill: "설명 단어 · 기대"
skill -> install: "폴더 복사"
host -> install: "발견 · 불러오기"
user -> host: "작업 요청"
host -> tmp: "브리프 쓰기"
host -> workers: "발송 3개씩"
workers -> tmp: "결과 파일"
host -> gate: "결과 판정"
host -> advisor: "상담"
host -> api: "CLI 없음"
