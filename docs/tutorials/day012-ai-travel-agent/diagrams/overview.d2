...@../../_tools/theme
direction: right

input: "입력" {
  class: group
  user: 사용자 { class: person }
  keys: OpenAI 키 + SerpAPI 키 { class: file }
}

external: "외부 API" {
  class: group
  openai: OpenAI (gpt-4o) { class: ext }
  serpapi: SerpAPI (search_google) { class: ext }
}

app: "travel_agent.py (처리 순서 1~5)" {
  class: ours
  grid-columns: 1

  ui: "1. Streamlit 입력 폼" { class: ours }
  researcher: "2. Researcher Agent" { class: ours }
  planner: "3. Planner Agent" { class: ours }
  state: "4. 세션 상태 (itinerary)" { class: store }
  ics: "5. ICS 생성 함수" { class: ours }
}

input.user -> app: 목적지와 일수 입력
input.keys -> app: 인증 정보
app -> external.openai: 검색어 생성 · 일정 초안 요청
app -> external.serpapi: search_google 도구 호출
external.openai -> app: 검색어 3개 · 일정 텍스트
external.serpapi -> app: 검색 결과
app -> input.user: travel_itinerary.ics 내려받기
