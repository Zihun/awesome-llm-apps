...@../../_tools/theme
direction: down

user: 사용자 { class: person }
ui: Streamlit UI (journalist_agent.py) { class: ours }

editor: "Editor (Team)" {
  class: ours
  searcher: Searcher (Agent) { class: ours }
  writer: Writer (Agent) { class: ours }
}

openai: "OpenAI GPT-4o" { class: ext }
serpapi: "SerpApi (search_google)" { class: ext }
article_sites: "기사 원문 웹페이지 (read_article)" { class: ext }

user -> ui: 키 2개 + 주제 입력
ui -> editor: "run(query, stream=False)"
editor -> openai: "delegate_task_to_member 스키마"
editor.searcher -> serpapi: 검색어
editor.searcher -> openai: "메시지 + search_google 스키마"
editor.writer -> article_sites: "URL → 기사 JSON"
editor.writer -> openai: "메시지 + read_article 스키마"
