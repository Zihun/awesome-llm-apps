...@../../_tools/theme
direction: down

user: 독자 {
  height: 70
  class: person
}
agent: "코딩 에이전트" { class: ext; height: 60 }
installed: "설치된 사본" { class: file; height: 50 }
folder: "원본 스킬 폴더" {
  class: group
  grid-columns: 3
  skillmd: "SKILL.md" { class: file }
  ref: "scope-signals.md" { class: file }
  script: "scope_creep.py" { class: ours }
}
git: "git (로컬 프로그램)" { class: ext; height: 60 }
repo: "합성 git 저장소" { class: store; height: 60 }
makelab: "make_lab.py" { class: ours }
tools: "시험 도구 넷" { class: ours }
test2b: "test_scope_creep.py" { class: ours }
evalsj: "evals.json" { class: file; height: 50 }

user -> agent: "의도 · 질문"
agent -> user: "보고서"
folder -> installed: "복사"
agent -> installed: "읽기 · 실행"
folder -> git: "git diff"
git -> repo: "읽기"
makelab -> repo: "만들기"
folder -> agent: "JSON"
tools -> folder: "검사"
test2b -> folder: "실행"
evalsj -> agent: "프롬프트"
