...@../../_tools/theme
direction: down

user: 사용자 (브라우저) { class: person }

app: "Streamlit 프로세스 (앱 코드 main.py + mcp-agent 라이브러리)" {
  class: group
  grid-columns: 5
  grid-gap: 2
  ui: "Streamlit 화면" { class: ours }
  flow: "setup_agent ·\nrun_mcp_agent" { class: ours }
  mcpapp: "MCPApp" { class: ours }
  agent: "Agent browser" { class: ours }
  llm: "OpenAIAugmented\nLLM" { class: ours }
}

cfg: "mcp_agent.config.yaml" { class: file }
sec: "mcp_agent.secrets.yaml" { class: file }
logs: "logs/*.jsonl" { class: file }
mcp: "Playwright MCP 서버\n(npx, 자식 프로세스)" { class: ext }
web: "웹사이트 (브라우저)" { class: ext }
openai: "OpenAI (gpt-4o-mini)" { class: ext }

user -> app: "명령"
app -> user: "응답"
app -> cfg: "설정 읽기"
app -> sec: "비밀 읽기"
app -> logs: "로그 쓰기"
app -> mcp: "서버 실행·호출"
mcp -> app: "도구 목록·결과"
mcp -> web: "브라우저 조작"
web -> mcp: "페이지 내용"
app -> openai: "messages · tools"
openai -> app: "답 · 도구 호출"
