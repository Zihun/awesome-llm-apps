...@../../_tools/theme
shape: sequence_diagram

ui: Streamlit 화면 { class: ours }
openai: OpenAI API { class: ext }
emailer: 메일 에이전트 { class: ours }
smtp: Gmail SMTP { class: ext }

ui -> emailer: "send_rejection_email →\nrun(탈락 메일 지시\n+ feedback)"
emailer -> openai: "POST /v1/chat/completions\n(model gpt-4o · 메시지 2개 · 도구 email_user)"
openai -> emailer: "tool_calls: email_user(subject, body)"
emailer -> smtp: "SMTP_SSL(smtp.gmail.com, 465)\n로그인 · send_message"
smtp -> emailer: "성공 또는 예외 → 문자열"
