...@../../_tools/theme
shape: sequence_diagram

user: "사용자" { class: person }
state: "session_state" { class: store }
app: "Streamlit 앱" { class: ours }
openai: "OpenAI (gpt-4o)" { class: ext }

user -> app: "질의 · 키 ·\nGenerate Code"
app -> state: "api_keys · model_provider 읽기\n(67-73행)"
state -> app: "키 · 제공자"
app -> openai: "chat.completions.create\n(system + user)"
openai -> app: "message.content"
app -> app: "백틱 걷어내기 (101-107행)"
app -> state: "st.session_state.generated_code =\n정리한 코드 (110행)"
app -> user: "st.code + 성공 문구"
