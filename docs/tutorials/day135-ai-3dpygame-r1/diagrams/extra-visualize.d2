...@../../_tools/theme
shape: sequence_diagram

user: "사용자" { class: person }
chrome: "Chrome 창" { class: ext }
session: "BrowserSession" { class: ours }
app: "Streamlit 앱" { class: ours }
state: "session_state" { class: store }

user -> app: "Generate Visualization"
app -> state: "generated_code 있나 (122행)"
