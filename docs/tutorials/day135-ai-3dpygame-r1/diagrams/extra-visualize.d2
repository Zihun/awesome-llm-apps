app -> session: "BrowserSession().start()\n(126-128행)"
session -> chrome: "Chrome 실행 ·\nCDP 연결"
chrome -> session: "CDP 주소"
app -> app: "ChatOpenAI · 에이전트 넷 만들기\n(129-168행)"
