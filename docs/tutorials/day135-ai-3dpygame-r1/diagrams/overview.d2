...@../../_tools/theme
direction: right

example: "ai_gen_game01.py\n(예시, 호출 없음)" { class: file }

web: "브라우저 쪽" {
  class: group
  grid-columns: 1
  grid-gap: 0
  chrome: "Chrome 창\n(CDP)" { class: ext }
  trinket: "trinket.io" { class: ext }
}

agents: "BrowserAgent 넷\n(+ 세션)" { class: ours }

stats: "browser-use\n익명 통계" { class: ext }
pypi: "PyPI\n(버전 확인)" { class: ext }
gemini: "Gemini 1.5 Pro\n(종료됨)" { class: ext }

user: 사용자 { class: person }

openai: "OpenAI\n(gpt-4o)" { class: ext }

app: "Streamlit 앱\n(앱 파일)" { class: ours }

user -> app: "질의 · 클릭"
app -> user: "코드 · 문구"
app -> openai: "system + user"
openai -> app: "코드 글"
app -> gemini: "생성 요청"
gemini -> app: "응답 글"
app -> agents: "과제 글 넷"
agents -> openai: "과제 · 화면"
openai -> agents: "다음 행동"
agents -> web: "CDP 조작"
web -> agents: "화면 · 요소"
agents -> stats: "익명 통계"
agents -> pypi: "버전 확인"
