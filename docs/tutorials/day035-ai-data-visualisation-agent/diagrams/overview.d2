...@../../_tools/theme
direction: down

user: 사용자 { class: person }

app: "ai_data_visualisation_agent.py" {
  class: group
  grid-columns: 3
  shell: "1. 사이드바 키·모델 (main)" { class: ours }
  runner: "2. 업로드·질문·실행 (main)" { class: ours }
  upload_fn: "3. 데이터셋 업로드 (upload_dataset)" { class: ours }
  chat_fn: "4. LLM 호출 (chat_with_llm)" { class: ours }
  interpret_fn: "5. 코드 실행 (code_interpret)" { class: ours }
}

svc: "외부 서비스" {
  class: group
  e2b: E2B 샌드박스 { class: ext }
  together: Together AI { class: ext }
}

user -> app: 키 2개 + 모델 선택
user -> app: CSV 업로드 + 질문
app -> svc.e2b: 파일 쓰기
app -> svc.together: 프롬프트+질문
app -> svc.e2b: 코드 실행
app -> svc.e2b: 생성
app -> user: 이미지·표·텍스트 응답
