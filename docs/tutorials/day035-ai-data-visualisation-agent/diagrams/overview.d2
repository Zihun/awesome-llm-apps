...@../../_tools/theme
direction: down
grid-columns: 2

entry: "진입" {
  class: group
  user: 사용자 { class: person }
}

ui: "브라우저에 그려지는 화면" {
  class: group
  grid-columns: 2
  shell: 사이드바 키·모델 (main) { class: ours }
  runner: 업로드·질문·실행 (main) { class: ours }
}

fns: "이 파일의 헬퍼 함수 3개" {
  class: group
  grid-columns: 1
  upload_fn: 데이터셋 업로드 (upload_dataset) { class: ours }
  chat_fn: LLM 호출 (chat_with_llm) { class: ours }
  interpret_fn: 코드 실행 (code_interpret) { class: ours }
}

svc: "외부 서비스 두 개" {
  class: group
  grid-columns: 2
  e2b: E2B 샌드박스 { class: ext }
  together: Together AI { class: ext }
}

entry.user -> ui.shell: 키 2개 + 모델 선택
entry.user -> ui.runner: CSV 업로드 + 질문
ui.runner -> svc.e2b: Sandbox(api_key=...) 생성
ui -> fns: 업로드 파일 객체
fns -> svc.e2b: 데이터셋 파일 쓰기 · 코드 실행 요청
ui.shell -> fns.chat_fn: 저장된 키·모델 (session_state)
ui.runner -> fns.chat_fn: 질문 + 데이터셋 경로
fns -> svc.together: 시스템 프롬프트 + 질문
fns.chat_fn -> fns.interpret_fn: 추출된 파이썬 코드
fns.interpret_fn -> ui.runner: 실행 결과
ui.runner -> entry.user: 이미지·표·텍스트 응답
