...@../../_tools/theme
shape: sequence_diagram

main: "main" { class: ours }
round_one: "round_one" { class: ours }
ask: "ask" { class: ours }
openrouter: "OpenRouter" { class: ext }

main -> round_one: "round_one(client, 모델 셋,\n프롬프트, timeout)"
round_one -> ask: "ask(모델마다 스레드 하나)"
ask -> openrouter: "POST chat/completions\n(프롬프트 · usage.include)"
openrouter -> ask: "답 글 · 토큰 · cost"
ask -> round_one: "Answer(ok, 글,\n시간, 토큰, 비용)"
