...@../../_tools/theme
direction: right

user: 사용자 { class: person }

ui: "화면" {
  class: group
  label.near: bottom-center
  grid-columns: 1
  chat: "채팅" { class: ours }
  kit: "UI 키트" { class: ours }
  render: "렌더러" { class: ours }
}

rt: "런타임" { class: ours }

agent: "에이전트" {
  class: group
  grid-columns: 1
  endpoint: "서버" { class: ours }
  graph: "그래프" { class: ours }
  tools: "도구" { class: ours }
  patch: "패치" { class: ours }
  mem: "저장소" { class: store }
}

llm: "gpt-5.5\n(가짜)" { class: ext }
tavily: "Tavily\n(가짜)" { class: ext }
fonts: "글꼴" { class: ext }

user -> ui.chat: "질문"
ui -> rt: "요청"
rt -> agent: "AG-UI"
agent -> llm: "모델 요청"
agent -> tavily: "/search"
ui -> fonts: "글꼴\n요청"
