...@../../_tools/theme
shape: sequence_diagram

user: 사용자 { class: person }
ui: "브라우저 화면\n(소스로만)" { class: ours }
rt: "CopilotKit 런타임\n(소스로만)" { class: ours }
agent: "에이전트 서버\n(main.py·그래프)" { class: ours }
mem: "체크포인터\n(메모리)" { class: store }
llm: "gpt-5.5\n(가짜)" { class: ext }

user -> ui: "질문 입력"
ui -> rt: "POST /api/copilotkit\n{method: agent/run}"
rt -> agent: "POST /\nRunAgentInput"
agent -> mem: "aget_state\n(스레드 기록)"
mem -> agent: "이전 메시지"
agent -> mem: "put\n(step -1: 입력)"
agent -> mem: "put_writes\n(입력 메시지)"
agent -> mem: "put\n(step 0)"
agent -> mem: "put_writes\n(normalize_context)"
agent -> mem: "put\n(step 1)"
agent -> agent: "App Context 시스템\n메시지를 붙임"
agent -> mem: "put_writes\n(App Context 포함)"
agent -> mem: "put\n(step 2)"
