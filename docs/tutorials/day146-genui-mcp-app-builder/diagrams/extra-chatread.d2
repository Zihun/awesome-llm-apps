...@../../_tools/theme
shape: sequence_diagram

sb: "샌드박스 MCP 서버" { class: ours }
rt: "에이전트 경로 (mastra-agent)" { class: ours }
ui: "브라우저 (렌더러)" { class: ours }

rt -> ui: "RUN_STARTED"
rt -> sb: "initialize"
sb -> rt: "initialize 응답"
rt -> sb: "notifications/initialized"
rt -> sb: "resources/read"
sb -> rt: "위젯 HTML"
rt -> sb: "연결 닫기 (finally)"
rt -> ui: "RUN_FINISHED {result} (<base> 정리)"
