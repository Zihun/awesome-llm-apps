...@../../_tools/theme
shape: sequence_diagram

user: 사용자 { class: person }
ui: "브라우저 (CopilotKit)" { class: ours }
rt: "에이전트 경로 (mastra-agent)" { class: ours }
mcp: "MCP 서버들 (헤더 목록)" { class: ext }

user -> ui: "팁 계산기 위젯 만들어 줘"
ui -> rt: "POST (x-mcp-servers · 메시지 · 화면 행동)"
rt -> mcp: "initialize (UI 도구 찾기용 연결)"
mcp -> rt: "initialize 응답"
rt -> mcp: "notifications/initialized"
rt -> mcp: "tools/list"
mcp -> rt: "도구 이름 · 설명 · 스키마 · _meta (ui/resourceUri)"
rt -> mcp: "연결 닫기 (client.close)"
rt -> mcp: "initialize (모델용 MCPClient 연결)"
mcp -> rt: "initialize 응답"
rt -> mcp: "notifications/initialized"
rt -> mcp: "tools/list"
mcp -> rt: "도구 (서버ID_이름)"
rt -> mcp: "return 직후 finally: 연결 닫기"
