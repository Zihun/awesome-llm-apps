...@../../_tools/theme
shape: sequence_diagram

ui: "브라우저 (CopilotKit)" { class: ours }
rt: "에이전트 경로 (mastra-agent)" { class: ours }
llm: "OpenAI gpt-5.5" { class: ext }

rt -> llm: "도구 결과"
llm -> rt: "add_mcp_server(endpoint, name)"
rt -> ui: "TOOL_CALL (화면 행동)"
rt -> ui: "RUN_FINISHED"
ui -> ui: "add_mcp_server 처리 (서버 목록에 더함)"
ui -> rt: "후속 POST (도구 결과가 메시지에 실림)"
