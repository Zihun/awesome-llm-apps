...@../../_tools/theme
direction: right

agentroute: "에이전트 경로\n(CopilotKit 런타임)" { class: ours }
sandbox: "샌드박스 안 MCP 서버\n(mcp-use, 원격)" { class: ours }
local: "pnpm dev의 로컬 MCP 서버\n(mcp-use, 독자 PC)" { class: ours }
nextdev: "next dev\n(웹)" { class: ours }
turbo: "turbo\n(pnpm dev)" { class: ours }
segment: "Segment · Scarf" { class: ext }
posthog: "PostHog · Scarf" { class: ext }
vnext: "Next.js 통계 서버" { class: ext }
vturbo: "Turborepo 통계 서버" { class: ext }

agentroute -> segment: "인스턴스 정보 (5% 표본)"
sandbox -> posthog: "server_run · 도구 호출"
local -> posthog: "server_run · 도구 호출"
nextdev -> vnext: "익명 사용 통계"
turbo -> vturbo: "익명 사용 통계"
