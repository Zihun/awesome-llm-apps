...@../../_tools/theme
shape: sequence_diagram

gen: "생성기\n(podcast_generator_\nprocessor.py)" { class: ours }
scrape: "스크랩 에이전트·크롤러\n(pipeline/scrape_agent.py,\ntools/browser_crawler.py)" { class: ours }
chromium: "Chromium\n(Playwright)" { class: ext }
site: "기사 사이트" { class: ext }

gen -> scrape: "scrape_agent_run(prompt, items)"
scrape -> chromium: "chromium.launch(headless=True, args=[--no-sandbox, --disable-setuid-sandbox])"
scrape -> chromium: "page.goto(url, timeout=20000) — 스크랩할 URL마다"
chromium -> site: "HTTP GET — URL마다"
site -> chromium: "HTML — URL마다"
chromium -> scrape: "page.url (final_url) — URL마다"
scrape -> site: "newspaper.article(final_url) — URL마다"
site -> scrape: "HTML — URL마다"
scrape -> gen: "full_text · published_date"
