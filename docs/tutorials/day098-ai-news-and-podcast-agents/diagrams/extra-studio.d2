...@../../_tools/theme
direction: down

api: "FastAPI\n(async_podcast_agent_router.py)" { class: ours }
worker: "Celery 워커\n(celery_tasks.py · agent_chat)" { class: ours }
redis: "Redis\n(브로커 · 락 · 결과)" { class: store }

sessions: "세션 저장소" {
  class: group
  grid-rows: 2
  grid-gap: 8
  agent_sessions: "agent_sessions.db" { class: store }
  internal_sessions: "internal_sessions.db" { class: store }
}

articles: "기사 저장소" {
  class: group
  grid-rows: 2
  grid-gap: 8
  tracking: "feed_tracking.db" { class: store }
  faiss: "FAISS 색인" { class: store }
}

result: "결과" {
  class: group
  grid-rows: 2
  grid-gap: 8
  podcasts: "podcasts.db" { class: store }
  media: "podcasts/" { class: file }
}

ext: "외부 서비스" {
  class: group
  grid-rows: 2
  grid-gap: 8
  openai: "OpenAI API" { class: ext }
  browser: "Chromium" { class: ext }
}

api -> redis: "delay() · lock_info 조회"
worker -> redis: "작업 수신 · 결과 · 락"
worker -> sessions: "대화 기록 · 세션 상태"
worker -> articles: "기사 검색 도구"
worker -> result: "저장 · 오디오 · 배너"
worker -> ext: "gpt-4o · DALL·E · 브라우저 검색"
