...@../../_tools/theme
shape: sequence_diagram

tracking: "feed_tracking.db\n(crawled_articles)" { class: store }
search: "검색 에이전트·도구\n(pipeline/search_agent.py,\ntools/embedding_search.py)" { class: ours }
sources: "sources.db\n(sources)" { class: store }

search -> tracking: "get_article_details(ids)"
tracking -> search: "제목 · URL · 요약 · 본문 · 발행일 · source_id"
search -> sources: "get_source_names(source_ids)"
sources -> search: "출처 이름"
