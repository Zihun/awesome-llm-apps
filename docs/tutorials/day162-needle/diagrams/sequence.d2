bg: "background.js" { class: ours }
dev: "dev.mjs · api" { class: ours }
search: "search.mjs" { class: ours }
gw: "AI Gateway (Jev)" { class: ext }

user -> content: "질문 입력 (0.7초 쉬면 검색)"
