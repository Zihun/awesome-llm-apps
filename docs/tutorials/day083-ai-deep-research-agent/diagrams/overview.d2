...@../../_tools/theme
direction: down

user: 사용자 { class: person }

app: "deep_research_openai.py" {
  class: ours
  grid-columns: 3

  sidebar: "1. 사이드바 키 입력" { class: ours }
  tool: "2. deep_research 도구" { class: ours }
  research: "3. 조사 에이전트" { class: ours }
  elaborate: "4. 정교화 에이전트" { class: ours }
  orchestrate: "5. 연구 실행 루틴" { class: ours }
  result: "6. 결과 화면" { class: ours }
}

external: "외부 API" {
  class: group
  openai: OpenAI API { class: ext }
  firecrawl: Firecrawl API { class: ext }
}

user -> app: 키 2개·주제 입력, Start Research 클릭
app -> external.openai: 조사·정교화 추론 요청
app -> external.firecrawl: 검색 질의와 파라미터
app -> user: 보고서 표시와 마크다운 다운로드
