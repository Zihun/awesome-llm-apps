...@../../_tools/theme
direction: down

user: 사용자 { class: person }

app: "deep_research_openai.py" {
  class: ours

  sidebar: "키 입력" { class: ours }
  tool: "deep_research" { class: ours }
  research: "조사 에이전트" { class: ours }
  elaborate: "정교화 에이전트" { class: ours }
  orchestrate: "실행 루틴" { class: ours }
  result: "결과 화면" { class: ours }
}

openai: OpenAI API { class: ext }
firecrawl: Firecrawl API { class: ext }

user -> app: 키 2개·주제 입력, Start Research 클릭
app.research -> openai: 주제 + 지시문 + 도구 스키마
app.elaborate -> openai: 주제 + 1차 보고서
app.tool -> firecrawl: 검색 질의와 파라미터
app.result -> user: 보고서 표시와 마크다운 다운로드
