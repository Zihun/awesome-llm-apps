...@../../_tools/theme
direction: down

ui: Streamlit 화면 (st.sidebar.success) { class: ours }
story_agent: 스토리 (story_agent) { class: ours }
update_story: update_story_overview { class: ours }
gameplay_agent: 게임플레이 (gameplay_agent) { class: ours }
update_gameplay: update_gameplay_overview { class: ours }
