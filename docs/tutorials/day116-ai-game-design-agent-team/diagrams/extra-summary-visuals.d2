...@../../_tools/theme
shape: sequence_diagram

ui: Streamlit 화면 { class: ours }
gameplay_agent: 게임플레이 { class: ours }
visuals_agent: 비주얼 { class: ours }
gpt: GPT-4o mini { class: ext }

