...@../../_tools/theme
shape: sequence_diagram

app: "화면 (app.js)" { class: ours }
tool: "서버 (execute_tool)" { class: ours }
flash: "Gemini Flash (가짜)" { class: ext }
graph: "청구 그래프 (agent.py)" { class: ours }
rules: "규칙 (policies.py)" { class: ours }

tool -> app: "tool: sync_claim_packet, running"
graph -> flash: "정리 요청 (ClaimNarrative)"
flash -> graph: "claim JSON"
graph -> rules: "prepare_claim · validate_required_claim_fields"
rules -> graph: "field_validation"
graph -> flash: "분류 요청 (ClaimClassification)"
flash -> graph: "classification JSON"
