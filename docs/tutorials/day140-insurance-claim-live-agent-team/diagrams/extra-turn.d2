...@../../_tools/theme
shape: sequence_diagram

user: 사용자 { class: person }
app: "화면 (app.js)" { class: ours }
ws: "서버 (live_voice)" { class: ours }
live: "Gemini Live (가짜)" { class: ext }
graph: "청구 그래프 (agent.py)" { class: ours }

user -> app: "글 입력 · 전송"
app -> ws: "{type: text, text, id}"
ws -> app: "transcript (Claimant)"
ws -> graph: "run_claim_workflow(대화)"
ws -> live: "client_content(user 턴)"
live -> ws: "tool_call: lookup_policy · sync_claim_packet · draw_incident_sketch"
