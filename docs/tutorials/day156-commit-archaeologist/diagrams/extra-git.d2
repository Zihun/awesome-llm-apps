...@../../_tools/theme
shape: sequence_diagram

script: "archaeologist.py" { class: ours }
git: "git (로컬)" { class: ext }

script -> git: "rev-parse · ls-files · show"
git -> script: "경로 · 줄 수"
script -> git: "log -L 또는 --follow"
git -> script: "커밋 해시 목록"
script -> git: "커밋마다 show -s · diff-tree"
git -> script: "메시지 · 바뀐 파일"
script -> git: "blame --line-porcelain"
git -> script: "줄별 작성자"
script -> script: "문턱 · 분류 · 신호"
