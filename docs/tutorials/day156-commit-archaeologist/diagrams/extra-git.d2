...@../../_tools/theme
shape: sequence_diagram

script: "archaeologist.py" { class: ours }
git: "git (로컬)" { class: ext }

script -> git: "rev-parse --show-toplevel"
git -> script: "저장소 맨 위"
script -> git: "ls-files --error-unmatch"
git -> script: "추적 여부"
script -> git: "show HEAD:파일 (줄 모드만)"
git -> script: "현재 내용 (줄 수)"
script -> git: "log -L 또는 --follow"
git -> script: "커밋 해시 목록"
