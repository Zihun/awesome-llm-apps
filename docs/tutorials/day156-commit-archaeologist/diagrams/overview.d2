...@../../_tools/theme
direction: down

user: 독자 {
  class: person
  label.near: outside-top-center
}

skill: "스킬 폴더\n(.claude/skills/commit-archaeologist)" {
  class: group
  grid-columns: 1
  skillmd: "SKILL.md\n(에이전트용 지시문)" { class: file }
  ref: "reading-git-history.md\n(해석 안내)" { class: file }
}

script: "scripts/archaeologist.py" {
  class: group
  grid-columns: 3
  check: "입력 검증\n(normalize_inputs)" { class: ours }
  hist: "이력 수집\n(read_commit)" { class: ours }
  who: "현재 작성자\n(blame_authors)" { class: ours }
  co: "함께 바뀐 파일\n(summarize_co_changes)" { class: ours }
  intent: "의도 단서\n(intent_signals)" { class: ours }
}

repo: "대상 저장소 (.git)" { class: store }
agent: "코딩 에이전트\n(이 문서는 띄우지 않음)" { class: ext }
evals: "시험\n(test_archaeologist.py)" { class: ours }

user -> skill: "폴더 복사"
user -> script: "저장소 · 파일 · --lines"
evals -> script: "합성 저장소에 실행"
script -> repo: "git 하위 프로세스 (읽기만)"
script -> agent: "JSON · 터미널 요약"
skill -> agent: "지시문을 읽음"
