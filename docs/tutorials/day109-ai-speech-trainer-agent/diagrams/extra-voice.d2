...@../../_tools/theme
shape: sequence_diagram

facial_agent: facial_expression_agent { class: ours }
together: Together AI { class: ext }
coord: coordinator_agent { class: ours }
voice_agent: voice_analysis_agent { class: ours }
voice_tool: voice_analysis_tool { class: ours }

facial_agent -> coord: "도구 결과가 곧 응답\n(stop_after_tool_call)"
coord -> together: "chat/completions\n(도구: set_shared_context · transfer_task_to_member)"
together -> coord: "tool_call:\ntransfer_task_to_member"
coord -> voice_agent: "작업 전달\n(task + 앞 멤버 응답)"
voice_agent -> together: "chat/completions\n(도구: analyze_voice_attributes)"
together -> voice_agent: "tool_call:\nanalyze_voice_attributes"
voice_agent -> voice_tool: "analyze_voice_attributes\n(경로)"
