...@../../_tools/theme
direction: down

llm: "gpt-5.5\n(OpenAI)" { class: ext }
rt: "런타임 + 미들웨어\n(route.ts)" { class: ours }
host: "iframe 호스트\n(CopilotKit)" { class: ours }
app: "항공권 앱\n(iframe)" { class: ours }

mcp: "MCP 서버 도구 16개" {
  class: group
  label.near: bottom-center
  ui: "UI 도구 4개\n(search-flights 등)" { class: ours }
  helper: "도우미 12개\n(select-flight 등)" { class: ours }
}

llm -> rt: "tool_call\n(4개 중 하나)"
app -> host: "tools/call\n(이름 아무거나)"
host -> rt: "__proxiedMCP\nRequest"
rt -> mcp.ui: "tools/call\n(모델 경로 · 프록시)"
rt -> mcp.helper: "tools/call\n(프록시만)"
