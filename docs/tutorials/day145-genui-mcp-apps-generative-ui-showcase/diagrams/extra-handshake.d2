...@../../_tools/theme
shape: sequence_diagram

app: "항공권 앱\n(안쪽 iframe)" { class: ours }
ui: "브라우저 화면\n(CopilotKit)" { class: ours }
proxy: "프록시\n(바깥 iframe)" { class: ours }

app -> ui: "ui/initialize\n(프록시가 중계)"
ui -> app: "hostCapabilities\n(프록시가 중계)"
app -> ui: "ui/notifications/\ninitialized"
ui -> app: "ui/notifications/\ntool-input"
ui -> app: "ui/notifications/\ntool-result"
app -> ui: "ui/notifications/\nsize-change"
