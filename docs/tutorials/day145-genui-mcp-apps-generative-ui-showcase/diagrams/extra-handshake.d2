...@../../_tools/theme
shape: sequence_diagram

app: "항공권 앱\n(안쪽 iframe)" { class: ours }
proxy: "프록시\n(바깥 iframe)" { class: ours }
ui: "브라우저 화면\n(CopilotKit)" { class: ours }

app -> proxy: "ui/initialize"
proxy -> ui: "ui/initialize\n(그대로 전달)"
ui -> proxy: "hostCapabilities"
proxy -> app: "hostCapabilities\n(그대로 전달)"
app -> proxy: "ui/notifications/\ninitialized"
proxy -> ui: "ui/notifications/\ninitialized\n(그대로 전달)"
