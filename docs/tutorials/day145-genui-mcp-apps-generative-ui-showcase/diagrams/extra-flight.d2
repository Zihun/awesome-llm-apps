...@../../_tools/theme
shape: sequence_diagram

user: 사용자 { class: person }
app: "항공권 앱\n(iframe)" { class: ours }
ui: "브라우저 화면\n(CopilotKit)" { class: ours }
rt: "런타임 +\n미들웨어" { class: ours }
mcp: "MCP 서버\n(:3001)" { class: ours }

user -> app: "항공편 고르고\n[좌석 선택]"
app -> ui: "tools/call\nselect-flight"
ui -> rt: "run + forwardedProps\n(__proxiedMCPRequest)"
rt -> ui: "RUN_STARTED"
rt -> mcp: "tools/call\nselect-flight"
mcp -> rt: "seatMap\n(20행 x 6열)"
rt -> ui: "RUN_FINISHED\n(result)"
ui -> app: "JSON-RPC 응답"
