...@../../_tools/theme
direction: down

front: "브라우저 쪽" {
  class: ours

  user: 사용자 { class: person }
  ui: Streamlit UI (app.py) { class: ours }
}

agent_scope: "에이전트 실행 범위 (before/after_agent_callback)" {
  class: ours

  model_scope: "모델 호출 범위 (before/after_model_callback)" {
    class: ours

    gemini: Gemini API (gemini-3-flash-preview) { class: ext }

    tool_scope: "도구 실행 범위 (before/after_tool_callback)" {
      class: ours
      tool_fn: 계산기 도구 (calculator_tool) { class: ours }
    }
  }
}

front -> agent_scope: run_agent(message)
agent_scope.model_scope.gemini -> agent_scope.model_scope.tool_scope: 함수 호출이면 위임
agent_scope.model_scope.tool_scope -> agent_scope.model_scope.gemini: 결과를 담아 재요청
agent_scope -> front: 최종 텍스트
