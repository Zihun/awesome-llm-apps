...@../../_tools/theme
direction: down

front: "사용자 쪽 화면" {
  class: group
  grid-columns: 2
  user: 사용자 { class: person }
  ui: "Streamlit 앱" { class: ours }
}

search: "RAGLite 검색" {
  class: group
  grid-columns: 2
  hybrid: "하이브리드 검색 (키워드+벡터, RRF)" { class: ext }
  rerank: "재순위화 (FlashRank)" { class: ext }
}

models: "로컬 모델 (llama-cpp-python)" {
  class: group
  grid-columns: 2
  embed: "임베더 (GGUF)" { class: ext }
  llm: "LLM (GGUF)" { class: ext }
}

data: "저장소" {
  class: group
  grid-columns: 2
  doc: "업로드 PDF" { class: file }
  db: "SQLite / PostgreSQL" { class: store }
}

front -> search: 질문 · 문서 텍스트
search -> models: 임베딩 요청
search -> data: 검색 · 삽입
models -> front: 스트리밍 답변
