...@../../_tools/theme
direction: down

user: 사용자 { class: person }
ui: Streamlit UI { class: ours }
client: OpenAI 클라이언트 { class: ours }
memory: mem0 Memory 계층 { class: ours }
openai_api: "OpenAI API" { class: ext }
