...@../../_tools/theme
shape: sequence_diagram

gpt: "GPT-4o mini" { class: ext }
white: "백 (Agent_White)" { class: ours }
gm: "진행자 (Game_Master)" { class: ours }
board: "판 상태" { class: store }

white -> gpt: "대화 + 이동 결과"
gpt -> white: "글: I have made\nmy move."
white -> gm: "글 메시지"
gm -> board: "check_made_move():\nTrue 읽고 False로"
board -> gm: "True → 중첩 대화 끝"
