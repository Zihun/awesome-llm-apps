...@../../_tools/theme
shape: sequence_diagram

board: "판 상태" { class: store }
white: "백 (Agent_White)" { class: ours }
gm: "진행자 (Game_Master)" { class: ours }
tools: "도구 함수" { class: ours }

gm -> tools: "execute_move('c2c4')"
tools -> board: "push(c2c4) · SVG를\nmove_history에 추가 ·\nmade_move=True"
board -> tools: "말 · 체크 여부"
tools -> gm: "Moved pawn from c2\nto c4. (말 기호 생략)"
gm -> white: "tool_responses"
