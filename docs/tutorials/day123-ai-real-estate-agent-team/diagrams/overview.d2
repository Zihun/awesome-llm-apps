...@../../_tools/theme
direction: down

user: 사용자 { class: person; width: 56; height: 56 }

app: "ai_real_estate_agent_team.py (한 파일)" {
  class: group
  grid-columns: 3
  grid-gap: 8
  ui: "Streamlit 화면\n(사이드바 · 폼 · 탭)" { class: ours }
  seq: "순서 함수\n(run_sequential_analysis)" { class: ours }
  finder:"매물 찾기\n(DirectFirecrawlAgent)" { class: ours }
  market: "시장 분석\n(market_analysis_agent)" { class: ours }
  valuation: "매물 평가\n(property_valuation_agent)" { class: ours }
  idle: "쓰이지 않는 에이전트 둘\n(property_search_agent ·\n.agent)" { class: ours }
}

env: ".env 파일\n(load_dotenv)" { class: file }
firecrawl: "Firecrawl API\n(extract)" { class: ext; height: 70 }
sites: "Zillow · Realtor.com ·\nTrulia · Homes.com" { class: ext; height: 70 }
gemini: "Gemini API\n(gemini-2.5-flash)" { class: ext; height: 70 }
agno_api: "agno 통계 API" { class: ext; height: 60 }

env -> app: "기본 키\n(GOOGLE_API_KEY ·\nFIRECRAWL_API_KEY)"
user -> app: "키 · 도시 · 조건"
app -> user: "매물 · 분석 · 평가 탭"
app -> firecrawl: "extract 요청\n(URL · 프롬프트 · 스키마)"
firecrawl -> app: "properties 배열"
sites -> firecrawl: "페이지 내용"
app -> gemini: "분석 · 평가 프롬프트"
gemini -> app: "분석 · 평가 글"
app -> agno_api: "메타데이터\n(성공 시)"
