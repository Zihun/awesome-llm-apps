...@../../_tools/theme
direction: down

approval: "approval" { class: ours }
worker: "refactor_worker\n(파일마다 하나)" { class: ours }
aggregator: "aggregator" { class: ours }
chart: "차트 도구\n(generate_matplotlib_chart)" { class: ours }
