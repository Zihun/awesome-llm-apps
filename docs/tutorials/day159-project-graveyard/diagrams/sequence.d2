...@../../_tools/theme
shape: sequence_diagram

user: "독자" { class: person }
agent: "코딩 에이전트\n(실행 안 함)" { class: ext }
script: "graveyard.py" { class: ours }
skillmd: "SKILL.md" { class: file }

user -> agent: "끝내지 못한 프로젝트 중 뭘 끝낼까?"
