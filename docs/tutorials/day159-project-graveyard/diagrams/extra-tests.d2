...@../../_tools/theme
direction: right

lint: "skill_lint.py" { class: ours }
scan: "skill_scanner.py" { class: ours }
trigtool: "run_trigger_evals.py" { class: ours }
reglint: "registry_lint.py" { class: ours }
t2b: "test_graveyard.py\n(2b 단계)" { class: ours }
repo: "원본 스킬 폴더\n(agent_skills/\nproject-graveyard)" { class: file }
copy: "스크래치 설치본\n(.claude/skills/\nproject-graveyard)" { class: file }
trig: "trigger-cases.json\n(스킬마다 하나)" { class: file }
registry: "registry.json\n(+ README 목록 둘)" { class: file }
yardtmp: "임시 묘지\n(TEMP 아래)" { class: store }

lint -> repo: "구조 검사"
lint -> copy: "설치본 검사"
scan -> repo: "보안 검사"
trigtool -> repo: "설명 읽기"
trigtool -> trig: "양성 · 음성 점수"
reglint -> repo: "frontmatter 대조"
reglint -> registry: "레지스트리 대조"
t2b -> yardtmp: "가짜 프로젝트 만들기"
t2b -> repo: "graveyard.py 실행"
