...@../../_tools/theme
direction: right
grid-columns: 2

access: "진입 경로" {
  class: group
  grid-columns: 2
  user: 사용자 { class: person }
  ui: Streamlit UI (agent_runner) { class: ours }
}

lessons: "4개 서브 레슨" {
  class: group
  grid-columns: 2
  ex: 실행 방법 (4_1) { class: ours }
  conv: 대화 관리 (4_2) { class: ours }
  cfg: 실행 설정 (4_3) { class: ours }
  stream: 스트리밍 (4_4) { class: ours }
}

runtime: "실행 계층" {
  class: group
  grid-columns: 2
  store: 저장소 (SQLiteSession) { class: store }
  streamresult: 핸들 (RunResultStreaming) { class: file }
  api: OpenAI API { class: ext }
}

access.user -> access.ui: 데모 선택
access.user -> lessons: 터미널 직접 실행
access.ui -> runtime.api: 세 실행 메서드
access.ui -> runtime.store: 대화 이력
lessons.ex -> runtime.api: run·run_sync·run_streamed
lessons.conv -> runtime.store: 대화 이력
lessons.cfg -> runtime.api: RunConfig 설정
lessons.stream -> runtime.streamresult: 반환값
runtime.streamresult -> runtime.api: stream_events() 순회
