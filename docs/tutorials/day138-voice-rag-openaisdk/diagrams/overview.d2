...@../../_tools/theme
direction: right

user: 사용자 { class: person }
env: ".env\n(load_dotenv)" { class: file }

app: "rag_voice.py" {
  class: group
  ui: "화면 ·\n사이드바\n(main)" { class: ours }
  state: "session_state" { class: store }
  pdf: "PDF 읽기 ·\n자르기\n(process_pdf)" { class: ours }
  store: "임베딩 저장\n(store_\nembeddings)" { class: ours }
  query: "질문 처리\n(process_\nquery)" { class: ours }
  agents: "에이전트 둘\n(setup_\nagents)" { class: ours }
}

chat: "Responses API\n(gpt-4o)" { class: ext }
tts: "음성 합성\n(gpt-4o-mini-tts)" { class: ext }
traces: "트레이스\n(traces/ingest)" { class: ext }
tmp: "임시 파일\n(tmp*.pdf · *.mp3)" { class: file }
embed: "임베딩 모델\n(fastembed·로컬)" { class: ext }
speaker: "스피커\n(sounddevice)" { class: ext }
qdrant: "Qdrant\n(벡터 저장소)" { class: store }

user <- app: "글 답·\nmp3·출처" { style.font-size: 12 }
user -> app: "PDF·키·\n질문·\n목소리"
app <- env: "환경변수\n(155행이\n덮음)" { style.font-size: 12 }
app -> chat: "Runner.run\n×2"
chat -> app: "final_output"
app -> tts: "speech.create\n×2"
tts -> app: "pcm 스트림\n· mp3"
app -> traces: "run 기록\n(끄지 않으면)"
app -> tmp: "PDF·mp3\n바이트"
tmp -> app: "PDF 쪽 ·\nmp3 경로"
app -> embed: "청크 ·\n질문 글"
embed -> app: "벡터"
app -> speaker: "pcm 재생"
app -> qdrant: "벡터 + 글"
qdrant -> app: "가까운 3개"
