...@../../_tools/theme
direction: right

ui: "화면\n(main)" { class: ours }
query: "질문 처리\n(process_query)" { class: ours }
chat: "Responses API\n(gpt-4o)" { class: ext }
traces: "트레이스\n(traces/ingest)" { class: ext }
tts: "음성 합성\n(gpt-4o-mini-tts)" { class: ext }
speaker: "스피커\n(LocalAudioPlayer)" { class: ext }
