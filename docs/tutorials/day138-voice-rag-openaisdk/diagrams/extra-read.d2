...@../../_tools/theme
shape: sequence_diagram

ui: "화면\n(main)" { class: ours }
loader: "PyPDFLoader\n(langchain)" { class: ours }
tmp: "임시 파일\n(tmp*.pdf)" { class: file }

ui -> tmp: "PDF 바이트 쓰기 (108-109행)"
ui -> loader: "PyPDFLoader(path).load() (110-111행)"
loader -> tmp: "파일 열어 읽기"
tmp -> loader: "쪽 글"
loader -> ui: "쪽마다 Document 목록"
ui -> ui: "file_name · timestamp 메타데이터 보탬 (114-119행)"
