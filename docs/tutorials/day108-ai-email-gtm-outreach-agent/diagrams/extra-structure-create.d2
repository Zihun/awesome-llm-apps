...@../../_tools/theme
direction: right

main: "화면\n(main)" { class: ours }
finder: "기업 탐색\n(CompanyFinderAgent)" { class: ours }
contact: "연락처 탐색\n(ContactFinderAgent)" { class: ours }
research: "기업 조사\n(ResearchAgent)" { class: ours }
writer: "이메일 작성\n(EmailWriterAgent)" { class: ours }

main -> finder: "create_company_finder_agent()"
finder -> main: "Agent"
main -> contact: "create_contact_finder_agent()"
contact -> main: "Agent"
main -> research: "create_research_agent()"
research -> main: "Agent"
main -> writer: "create_email_writer_agent(\n스타일)"
writer -> main: "Agent"
