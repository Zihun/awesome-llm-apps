...@../../_tools/theme
shape: sequence_diagram

user: "사용자" { class: person }
main: "화면 (main)" { class: ours }
writer: "이메일 작성\n(EmailWriterAgent)" { class: ours }
openai: "OpenAI API\n(gpt-5)" { class: ext }

main -> writer: "run(\"Write personalized...\nContacts JSON · Research JSON\")"
writer -> openai: "gpt-5 요청\n(도구 없음)"
openai -> writer: "{\"emails\": [{company,\ncontact, subject, body}]}"
writer -> main: "resp.content\n→ extract_json_or_raise"
main -> user: "progress 100 · 결과 4구역과\n이메일 확장 상자"
