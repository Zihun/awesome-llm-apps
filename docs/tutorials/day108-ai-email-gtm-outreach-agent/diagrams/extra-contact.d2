...@../../_tools/theme
shape: sequence_diagram

user: "사용자" { class: person }
main: "화면 (main)" { class: ours }
run: "단계 함수\n(run_contact_finder)" { class: ours }
contact: "연락처 탐색\n(ContactFinderAgent)" { class: ours }
openai: "OpenAI API\n(gpt-4o)" { class: ext }

main -> user: "\"2/4 Finding contacts (2–3 per company)...\""
main -> run: "run_contact_finder(\n에이전트, 회사 목록, 설명, 제안)"
run -> contact: "run(\"For each company below,\nfind 2-3 decision makers...\nCompanies JSON\")"
contact -> openai: "gpt-4o 요청"
openai -> contact: "{\" companies\": [{name,\ncontacts}]} 텍스트"
contact -> run: "resp.content"
