...@../../_tools/theme
direction: down

ui: "Streamlit 화면\n(사이드바 · 입력 · 버튼)" { class: ours; width: 220 }
session: "세션 상태\n(API 키)" { class: store; width: 160 }
finder: "경쟁사 주소 찾기\n(get_competitor_urls)" { class: ours }
exa_agent: "Exa 탐색 에이전트\n(competitor_finder_agent)" { class: ours }
extractor: "정보 추출\n(extract_competitor_info)" { class: ours }
report: "비교 표\n(generate_comparison_report)" { class: ours }
analysis: "분석 에이전트\n(analysis_agent)" { class: ours }

ui -> session: "키 저장"
session -> finder: "검색 API 키"
session -> exa_agent: "Exa · OpenAI 키"
session -> extractor: "Firecrawl 키"
session -> analysis: "OpenAI 키"
ui -> finder: "get_competitor_urls(\nurl, description)"
finder -> exa_agent: "run(프롬프트)\n(Exa 선택 때만)"
ui -> extractor: "extract_competitor_info(\n주소)"
ui -> report: "generate_comparison_report(\ncompetitor_data)"
ui -> analysis: "generate_analysis_report(\ncompetitor_data)"
