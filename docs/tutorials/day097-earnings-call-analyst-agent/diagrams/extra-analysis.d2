...@../../_tools/theme
shape: sequence_diagram

sessions: "세션 저장소\n(sessions)" { class: store }
server: "FastAPI 서버\n(server.py)" { class: ours }
analyst: "분석가\n(agent.py)" { class: ours }
runtime: "ADK 실행기\n(adk_runtime.py)" { class: ours }

server -> sessions: "status: analysis (70%)"
server -> analyst: generate_insights(metadata, research, chunks)
analyst -> analyst: select_signal_chunks(chunks, 64)
analyst -> runtime: has_adk_credentials()
runtime -> analyst: "True"
