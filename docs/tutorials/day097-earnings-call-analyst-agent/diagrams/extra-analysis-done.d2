...@../../_tools/theme
shape: sequence_diagram

runtime: "ADK 실행기\n(adk_runtime.py)" { class: ours }
analyst: "분석가\n(agent.py)" { class: ours }
server: "FastAPI 서버\n(server.py)" { class: ours }

analyst -> runtime: parse_json_object(text)
runtime -> analyst: dict
analyst -> analyst: InsightEvent 검증 · 중복 제거
analyst -> analyst: _realign_event_times(events, chunks)
analyst -> server: "list[InsightEvent]"
