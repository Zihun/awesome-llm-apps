...@../../_tools/theme
direction: down

user: 사용자 { class: person; width: 56; height: 56 }

app: "ai_domain_deep_research_agent.py (한 파일)" {
  class: group
  grid-columns: 3
  grid-gap: 8
  screen: "Streamlit 화면\n(사이드바 · 입력 · 버튼)" { class: ours }
  state: "세션 상태\n(st.session_state)" { class: store; height: 108 }
  init: "모델 · 도구 준비\n(initialize_agents)" { class: ours }
  qgen: "질문 생성 Agent\n(Question Generator)" { class: ours }
  researcher: "질문별 조사 Agent\n(research_question)" { class: ours }
  reporter: "보고서 작성 Agent\n(Report Compiler)" { class: ours }
}

together: "Together AI\n(Qwen3 235B)" { class: ext; height: 60 }
composio: "Composio API" { class: ext; height: 60 }
agno_api: "Agno 통계 API" { class: ext; height: 60 }
services: "Composio가 대신 부르는 서비스" {
  class: group
  grid-columns: 3
  grid-gap: 8
  tavily: "Tavily 검색" { class: ext; height: 60 }
  perplexity: "Perplexity 검색" { class: ext; height: 60 }
  gdocs: "Google Docs" { class: ext; height: 60 }
}

user -> app: "키 · 주제 · 분야 · 클릭"
app -> user: "질문 · 답 · 보고서"
app -> composio: "get_tools · 도구 실행 요청"
composio -> app: "도구 정의 · 실행 결과"
app -> together: "지시문 + 요청 문장"
together -> app: "답 텍스트 · 도구 호출"
app -> agno_api: "실행 메타데이터"
composio -> services: "검색 · 문서 만들기"
