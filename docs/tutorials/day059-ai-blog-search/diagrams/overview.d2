...@../../_tools/theme
direction: down

front: "사용자 쪽 화면" {
  class: group
  grid-columns: 2
  user: 사용자 { class: person }
  ui: Streamlit UI (app.py) { class: ours }
}

ingest: 문서 적재 (add_documents) { class: ours }

graph: "LangGraph 워크플로" {
  class: group
  grid-columns: 4
  agent: 에이전트 (agent) { class: ours }
  retrieve: 검색 (retrieve) { class: ours }
  rewrite: 재작성 (rewrite) { class: ours }
  generate: 생성 (generate) { class: ours }
}

qdrant: Qdrant (qdrant_db) { class: store }
gemini: Gemini API { class: ext }
hub: LangChain Hub { class: ext }
blog: 블로그 { class: ext }

front -> ingest: Enter URL
front -> graph: Submit Query
ingest -> qdrant: 벡터 저장
ingest -> gemini: 임베딩
ingest -> blog: GET
graph -> qdrant: 유사도 검색
graph -> gemini: 모델 호출
graph -> hub: 프롬프트
