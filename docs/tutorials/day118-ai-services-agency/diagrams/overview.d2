...@../../_tools/theme
direction: down

user: 사용자 { class: person }
key: OpenAI API 키 (사이드바 입력) { class: file }

app: agency.py {
  grid-columns: 5
  ui: "화면\n(Streamlit)" { class: ours }
  agency: "Agency\n(agency-swarm)" { class: ours }
  ceo: "Project Director\n(Agent)" { class: ours }
  cto: "Technical Architect\n(Agent)" { class: ours }
  pm: "Product Manager\n(Agent)" { class: ours }
  dev: "Lead Developer\n(Agent)" { class: ours }
  cm: "Client Success\nManager\n(Agent)" { class: ours }
  t1: "분석 도구\n(Analyze\nProject\nRequirements)" { class: ours }
  t2: "명세 도구\n(Create\nTechnical\nSpecification)" { class: ours }
}

ctx: "공유 컨텍스트\n(user_context, 메모리)" { class: store }
openai: "OpenAI gpt-4.1\n(Responses API)" { class: ext }
traces: "OpenAI 트레이스\n(api.openai.com\n/v1/traces/ingest)" { class: ext }

user -> app: 프로젝트 폼
key -> app: OPENAI_API_KEY\n환경변수로 설정
app -> ctx: 분석 · 명세 저장
ctx -> app: 분석 읽기
app -> openai: 지시문 · 도구 스키마 · 대화 기록
app -> traces: 트레이스 · 스팬
