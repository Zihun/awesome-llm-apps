...@../../_tools/theme
direction: down

user: 사용자 { class: person; width: 56; height: 56 }

next: "Next.js 앱 (src/)" {
  class: group
  grid-columns: 2
  grid-gap: 12
  ui: "화면\n(page.tsx · 폼 · 카드)" { class: ours; height: 50 }
  route: "CopilotKit 런타임 라우트\n(api/copilotkit/route.ts)" { class: ours; height: 50 }
}

py: "Python 서버 (agent/main.py)" {
  class: group
  grid-columns: 3
  grid-gap: 12
  api: "AG-UI 엔드포인트\n(ADKAgent)" { class: ours; height: 50 }
  coach: "코치 에이전트\n(FinanceCoachAgent)" { class: ours; height: 50 }
  upd: "프로필 도구\n(update_financial_data)" { class: ours; height: 50 }
  specs: "분석 도구 넷\n(AgentTool)" { class: ours; height: 50 }
  state: "세션 상태\n(financial_data · 분석 결과)" { class: store }
}

gemini: "Gemini\n(gemini-3.5-flash)" { class: ext }
telem: "통계 서버\n(CopilotKit · Next.js)" { class: ext }

user -> next: "채팅 · 폼 입력"
next -> user: "상태 알림 · 카드"
next -> py: "POST /"
py -> next: "SSE"
next -> telem: "표본 통계"
py -> gemini: "모델 요청"
