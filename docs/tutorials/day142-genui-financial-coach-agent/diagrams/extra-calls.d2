...@../../_tools/theme
direction: down

py: "Python 서버 (agent/main.py)" {
  class: group
  api: "AG-UI 엔드포인트\n(ADKAgent)" { class: ours; height: 50 }
  coach: "코치 에이전트\n(FinanceCoachAgent)" { class: ours; height: 50 }
  upd: "프로필 도구\n(update_financial_data)" { class: ours; height: 50 }
  run_budget: "run_budget_analysis\n(AgentTool)" { class: ours; height: 50 }
  run_savings: "run_savings_strategy\n(AgentTool)" { class: ours; height: 50 }
  run_debt: "run_debt_reduction\n(AgentTool)" { class: ours; height: 50 }
  run_full: "run_full_analysis\n(AgentTool)" { class: ours; height: 50 }
}

gemini: "Gemini\n(gemini-3.5-flash)" { class: ext }

py.api -> py.coach: "run"
py.coach -> py.upd: "함수 호출"
py.coach -> py.run_budget: "AgentTool 호출"
py.coach -> py.run_savings: "AgentTool 호출"
py.coach -> py.run_debt: "AgentTool 호출"
py.coach -> py.run_full: "AgentTool 호출"
py.coach -> gemini: "코치 요청"
