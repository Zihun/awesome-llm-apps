...@../../_tools/theme
shape: sequence_diagram

user: 고객 { class: person }
ui: "Streamlit 화면" { class: ours }
agent: "CustomerSupportAIAgent" { class: ours }
openai: "OpenAI API" { class: ext }
memory: "mem0 Memory" { class: ours }

user -> ui: "'Generate Synthetic Data' 클릭\n(고객 ID가 있어야 함)"
ui -> agent: "generate_synthetic_data('alice')"
agent -> openai: "chat.completions.create(model='gpt-4',\nmessages=[system: '... Always respond with valid JSON.',\nuser: 프로필 · 주문 이력 요청])"
openai -> agent: "JSON 문자열 (choices[0].message.content)"
agent -> agent: "json.loads(content)\n→ customer_data (dict)"
agent -> memory: "add(json.dumps(item) 또는\n'키: 값', metadata={'app_id':\n'customer-support', 'role':\n'system'}) — 항목마다 한 번"
memory -> agent: "{'results': [...]}\n— add 한 번의 결과"
