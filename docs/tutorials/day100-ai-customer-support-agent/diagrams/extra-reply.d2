...@../../_tools/theme
shape: sequence_diagram

agent: "CustomerSupportAIAgent" { class: ours }
ui: "Streamlit 화면" { class: ours }
state: "세션 상태\n(st.session_state)" { class: store }
user: 고객 { class: person }

agent -> ui: "답변 문자열 반환\n(handle_query의 return)"
ui -> state: "st.session_state.messages.append({'role': 'assistant', 'content': answer})"
ui -> user: "답변을\n말풍선으로 표시\n(st.chat_message)"
