...@../../_tools/theme
shape: sequence_diagram

screen: Streamlit 화면 { class: ours }
openai: OpenAI (gpt-4o-mini) { class: ext }
librarian: Research Librarian { class: ours }
serp_tool: 검색 도구 { class: ours }
serpapi: SerpAPI { class: ext }

screen -> librarian: "run(주제 문장)"
librarian -> openai: "요청 (지시문 · 주제 · 도구 정의 둘)"
openai -> librarian: "도구 호출 요청 (search_google)"
librarian -> serp_tool: "search_google(query, num_results)"
serp_tool -> serpapi: "검색 요청 (query, num, 키)"
serpapi -> serp_tool: "검색 결과"
serp_tool -> librarian: "결과 JSON 문자열"
