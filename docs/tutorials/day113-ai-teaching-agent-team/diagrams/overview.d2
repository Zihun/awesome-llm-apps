...@../../_tools/theme
direction: down

browser: 사용자의 브라우저 (Streamlit 화면을 연 탭) {
  class: group
  user: 사용자 { class: person }
}

app: 앱 (teaching_agent_team.py) {
  class: group
  grid-rows: 3
  grid-gap: 10
  ui: Streamlit 화면 (teaching_agent_team.py) { class: ours }
  toolset: Composio 도구 준비 (ComposioToolSet) { class: ours }
  docs_tool: 문서 만들기 도구 (google_docs_tool) { class: ours }
  update_tool: 문서 고치기 도구 (google_docs_tool_update) { class: ours }
  serp_tool: 검색 도구 (SerpApiTools) { class: ours }
  professor: Professor (professor_agent) { class: ours }
  advisor: Academic Advisor (academic_advisor_agent) { class: ours }
  librarian: Research Librarian (research_librarian_agent) { class: ours }
  assistant: Teaching Assistant (teaching_assistant_agent) { class: ours }
}

composio_api: Composio API (backend.composio.dev) { class: ext }
gdocs: Google Docs { class: ext }
openai: OpenAI (gpt-4o-mini) { class: ext }
serpapi: SerpAPI { class: ext }
agno_api: Agno 통계 API { class: ext }
pypi: PyPI (pypi.org) { class: ext }

browser -> app: 키 · 주제 입력
app -> browser: 링크 · 답 표시
app -> composio_api: 도구 정의 조회
app -> composio_api: 문서 만들기 요청
composio_api -> gdocs: 문서 만들기
app -> serpapi: 검색어
app -> openai: 대화 · 도구
app -> agno_api: 실행 메타데이터
app -> pypi: 버전 확인 (끝날 때)
app -> composio_api: sentry 설정 (import 때)

app.*.height: 28
composio_api.height: 40
gdocs.height: 40
openai.height: 40
serpapi.height: 40
agno_api.height: 40
browser.user.height: 44
pypi.height: 40
