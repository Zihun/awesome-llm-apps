...@../../_tools/theme
shape: sequence_diagram

layer: "신뢰 계층 창구\n(TrustLayer)" { class: ours }
agent: "에이전트\n(GovernedAgent)" { class: ours }
demo: "데모\n(main)" { class: ours }
audit: "감사 기록\n(audit_log 리스트)" { class: store }
trust: "신뢰 점수 엔진\n(TrustScoringEngine)" { class: ours }

layer -> trust: "record_event(\"researcher-002\",\n\"scope_violation_attempt\")"
trust -> layer: "-50 (755 -> 705)"
layer -> audit: "AuditEntry(result=\"denied\")"
layer -> agent: "(False, \"Action 'send_email' denied\nfor role researcher\")"
agent -> demo: "{success: False, trust_score: 705,\nerror: \"Action denied: Action 'send_email'\ndenied for role researcher\"}"
