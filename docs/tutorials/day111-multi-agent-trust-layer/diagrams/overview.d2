...@../../_tools/theme
direction: right

user: 사용자 (터미널) { class: person }

app: "multi_agent_trust_layer.py (한 파일, 전부 메모리 안)" {
  class: group
  grid-columns: 3
  grid-gap: 8
  demo: "데모\n(main)" { class: ours }
  agent: "에이전트\n(GovernedAgent)" { class: ours }
  layer: "신뢰 계층 창구\n(TrustLayer)" { class: ours }
  registry: "신원 등록부\n(IdentityRegistry)" { class: ours }
  trust: "신뢰 점수 엔진\n(TrustScoringEngine)" { class: ours }
  deleg: "위임 관리자\n(DelegationManager)" { class: ours }
  policy: "정책 엔진\n(MultiAgentPolicyEngine)" { class: ours }
  audit: "감사 기록\n(audit_log 리스트)" { class: store }
}

user -> app: "python 실행"
app -> user: "print 출력\n(점수 · 감사 줄)"
