...@../../_tools/theme
direction: down

layer: "신뢰 계층 창구\n(TrustLayer)" { class: ours }
registry: "신원 등록부\n(IdentityRegistry)" { class: ours }
trust: "신뢰 점수 엔진\n(TrustScoringEngine)" { class: ours }

layer -> registry: "register(identity) ·\nget(agent_id)"
registry -> layer: "True / False ·\nAgentIdentity"
layer -> trust: "initialize · record_event ·\nget(agent_id)"
trust -> layer: "TrustScore · delta"
