...@../../_tools/theme
shape: sequence_diagram

trust: "신뢰 점수 엔진\n(TrustScoringEngine)" { class: ours }
layer: "신뢰 계층 창구\n(TrustLayer)" { class: ours }
audit: "감사 기록\n(audit_log 리스트)" { class: store }

layer -> trust: "record_event(\"researcher-002\",\n\"stayed_in_scope\")"
trust -> layer: "+5 (750 -> 755)"
layer -> audit: "AuditEntry(result=\"allowed\")"
