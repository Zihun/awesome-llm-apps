...@../../_tools/theme
shape: sequence_diagram

demo: "데모\n(main)" { class: ours }
agent: "에이전트\n(GovernedAgent)" { class: ours }
layer: "신뢰 계층 창구\n(TrustLayer)" { class: ours }
trust: "신뢰 점수 엔진\n(TrustScoringEngine)" { class: ours }

layer -> agent: "(True, \"Action allowed\")"
agent -> agent: "_execute_action:\n\"Executed web_search ...\""
agent -> layer: "get_trust_score(\"researcher-002\")"
layer -> trust: "get(\"researcher-002\")"
trust -> layer: "TrustScore(755, standard)"
layer -> agent: "755"
agent -> demo: "{success: True, result,\ntrust_score: 755}"
