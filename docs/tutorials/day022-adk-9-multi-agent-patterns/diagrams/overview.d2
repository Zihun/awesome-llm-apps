...@../../_tools/theme
direction: down
grid-rows: 3

front: "브라우저 쪽" {
  class: group
  grid-columns: 2
  user: 사용자 { class: person }
  app: Streamlit 앱 { class: ours }
}

lanes: "세 실행 패턴" {
  class: group

  seq_lane: {
    grid-columns: 2
    seq_shell: Seq { class: ours }
    seq_children: LLM4개 { class: ours }
  }
  loop_lane: {
    grid-columns: 2
    loop_shell: Loop { class: ours }
    loop_children: "LLM1+Base2" { class: ours }
  }
  par_lane: {
    grid-columns: 2
    par_shell: Parallel { class: ours }
    par_children: LLM3개 { class: ours }
  }
}

gemini: Gemini API (gemini-3-flash-preview) { class: ext }

front.user -> front.app: 주제 입력
front.app -> lanes.seq_lane.seq_shell: run_async (9_1)
front.app -> lanes.loop_lane.loop_shell: run_async (9_2)
front.app -> lanes.par_lane.par_shell: run_async (9_3)
lanes.seq_lane.seq_shell -> lanes.seq_lane.seq_children: 한 번에 하나씩
lanes.loop_lane.loop_shell -> lanes.loop_lane.loop_children: 매 반복마다
lanes.par_lane.par_shell -> lanes.par_lane.par_children: 동시에
lanes.seq_lane.seq_children -> gemini: 모델 호출
lanes.loop_lane.loop_children -> gemini: 모델 호출
lanes.par_lane.par_children -> gemini: 모델 호출
