...@../../_tools/theme
direction: down
grid-columns: 2

front: "브라우저 쪽" {
  class: group
  grid-columns: 2
  user: 사용자 { class: person }
  browser: 웹 UI { class: ext }
}

handlers: "Motia 스텝 (steps/)" {
  class: group
  grid-columns: 2
  api: ChatApi 스텝 { class: ours }
  ai: AiResponse 스텝 { class: ours }
}

back: "저장소·외부 API" {
  class: group
  grid-columns: 2
  store: conversation 스트림 { class: store }
  openai: OpenAI API { class: ext }
}

front -> handlers: POST /chat
handlers.api -> handlers.ai: chat-message 이벤트
handlers -> back: 메시지 저장 · 토큰마다 갱신 · 스트리밍 호출 (갱신은 WebSocket으로 브라우저에 푸시)
