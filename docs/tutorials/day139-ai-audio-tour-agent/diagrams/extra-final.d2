...@../../_tools/theme
shape: sequence_diagram

mgr: "투어 매니저 (manager.py)" { class: ours }
sdk: "에이전트 실행 (Runner)" { class: ours }
resp: "OpenAI 응답 API" { class: ext }
printer: "진행 표시 (printer.py)" { class: ours }

mgr -> printer: "Creating your personalized\ntour 진행 중"
mgr -> sdk: "Runner.run(orchestrator_agent,\n구역 글 + 목표 단어 수)"
sdk -> resp: "POST /v1/responses\n(gpt-4o-mini, JSON 스키마 FinalTour)"
resp -> sdk: "FinalTour JSON\n(소개 · 구역 넷 · 맺음)"
sdk -> mgr: "final_output_as(FinalTour)"
mgr -> printer: "Completed Final Tour Guide\nCreation 완료 표시"
