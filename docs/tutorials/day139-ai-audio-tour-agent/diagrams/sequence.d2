...@../../_tools/theme
shape: sequence_diagram

user: 사용자 { class: person }
ui: "화면 (ai_audio_tour_agent.py)" { class: ours }
mgr: "투어 매니저 (manager.py)" { class: ours }
printer: "진행 표시 (printer.py)" { class: ours }
resp: "OpenAI 응답 API" { class: ext }
sdk: "에이전트 실행 (Runner)" { class: ours }

user -> ui: "장소 · 관심사 · 길이,\nGenerate Tour 클릭"
ui -> mgr: "TourManager() 생성"
mgr -> printer: "Printer(console) 생성,\nLive 시작"
ui -> mgr: "run_async(mgr.run,\n장소, 관심사, 길이)"
mgr -> sdk: "gen_trace_id(),\ntrace() 블록 열기"
mgr -> printer: "View trace 링크 줄"
mgr -> printer: "Starting tour research\n완료 표시"
mgr -> printer: "Planning your personalized\ntour 진행 중"
mgr -> sdk: "Runner.run(planner_agent,\n장소 · 관심사 · 길이 글)"
sdk -> resp: "POST /v1/responses\n(gpt-4o, JSON 스키마 Planner)"
resp -> sdk: "Planner JSON\n(구역별 분)"
sdk -> mgr: "final_output_as(Planner)"
mgr -> printer: "Completed planning\n완료 표시"
