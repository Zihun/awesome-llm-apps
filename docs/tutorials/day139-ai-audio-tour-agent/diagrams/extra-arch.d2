...@../../_tools/theme
shape: sequence_diagram

mgr: "투어 매니저 (manager.py)" { class: ours }
sdk: "에이전트 실행 (Runner)" { class: ours }
resp: "OpenAI 응답 API" { class: ext }
printer: "진행 표시 (printer.py)" { class: ours }

mgr -> printer: "Exploring architectural\nwonders 진행 중"
mgr -> sdk: "Runner.run(architecture_agent,\n장소 · 관심사 · 단어 한도)"
sdk -> resp: "POST /v1/responses (gpt-4o-mini,\nweb_search_preview, tool_choice required)"
resp -> sdk: "웹 검색 호출 항목 +\nArchitecture JSON"
sdk -> mgr: "final_output_as(Architecture)"
mgr -> printer: "Completed architecture\nresearch 완료 표시"
