...@../../_tools/theme
direction: down

me: "독자" { class: person }

local: "내 컴퓨터" {
  grid-columns: 2
  class: group
  verify: "시험 (verify.js)" { class: ours }
  server: "정적 서버 (server.js)" { class: ours }
  page: "화면 한 파일 (index.html)" { class: file }
}

browser: "독자의 브라우저" {
  class: group
  scene: "장면·탭 (state)" { class: ours }
  sketch: "손그림 엔진 (ShapeCache)" { class: ours }
  flow: "흐름 (drawArrowAndParticles)" { class: ours }
  export: "내보내기 (save2xPng 외)" { class: ours }
}

store: "localStorage" { class: store }
fonts: "글꼴 서버 셋" { class: ext }
out: "내려받는 파일" { class: file }

me -> browser: "그리기"
me -> local: "curl"
browser <-> local: "GET · 응답"
browser -> fonts: "글꼴 요청"
browser <-> store: "저장·복원"
browser <-> out: "내보내기·가져오기"
