...@../../_tools/theme
direction: down

user: 사용자 { class: person }

code: "이 앱의 코드" {
  class: group
  grid-columns: 5
  ui: Streamlit UI { class: ours }
  orchestrator: 오케스트레이터 { class: ours }
  guardrails: 가드레일 { class: ours }
  indexer: KB 구축 { class: ours }
  bench: 벤치마크 { class: ours }
}

svc: "외부 서비스" {
  class: group
  grid-columns: 3
  openai: OpenAI { class: ext }
  tavily: Tavily { class: ext }
  jeebench: JEEBench { class: ext }
}

store: "로컬 저장소" {
  class: group
  grid-columns: 3
  qdrant: Qdrant { class: store }
  feedback: 피드백 로그 { class: file }
  csv: 벤치마크 결과 { class: file }
}

user -> code: 질문·피드백·문항 수
code -> store: 검색·저장
code -> svc: LLM·웹 검색·데이터
