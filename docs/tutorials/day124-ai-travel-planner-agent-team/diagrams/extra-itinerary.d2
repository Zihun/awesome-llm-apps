...@../../_tools/theme
shape: sequence_diagram

db: PostgreSQL { class: store }
openrouter: OpenRouter { class: ext }
dining: Culinary Guide { class: ours }
svc: plan_service { class: ours }
itin: Itinerary Specialist { class: ours }

dining -> svc: "messages[-1].content"
svc -> db: "update: Creating the\nday-by-day itinerary"
svc -> itin: "arun(일정 프롬프트 + 앞 네 글)"
itin -> openrouter: "chat/completions\n(도구 7개)"
openrouter -> itin: "일정 글"
