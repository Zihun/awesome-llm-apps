...@../../_tools/theme
direction: down

exa_tools: "ExaTools" { class: ours; height: 44 }
flights_tool: "get_google_flights" { class: ours; height: 44 }
scrape_tool: "scrape_website\n(tools/scrape.py)" { class: ours; height: 44 }
fc_tools: "FirecrawlTools (agno)" { class: ours; height: 44 }

exa: "Exa 검색 API" { class: ext; height: 56 }
gflights: "Google Flights" { class: ext; height: 56 }
playwright: "try.playwright.tech" { class: ext; height: 56 }
firecrawl: "Firecrawl API" { class: ext; height: 56 }

exa_tools -> exa: "POST /search {query, numResults, contents}"
flights_tool -> gflights: "GET /travel/flights\n(fast-flights, fetch_mode=fallback)"
flights_tool -> playwright: "200이 아니면 POST /service/control/run\n(코드와 조회 주소)"
scrape_tool -> firecrawl: "scrape_url(url, markdown,\nwait_for=30000)"
fc_tools -> firecrawl: "scrape (formats=markdown)"
